---
import Monogram from "./Monogram.astro";
import ThemeToggle from "./ThemeToggle.astro";
interface Props { heroOverlay?: boolean; }
const { heroOverlay = false } = Astro.props;
const links = [
  { href: "/work", label: "Now / Work" },
  { href: "/writing", label: "Writing" },
  { href: "/reading", label: "Reading" },
  { href: "/ambitions", label: "Ambitions" },
  { href: "/about", label: "About" },
];
const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
const tone = heroOverlay ? "light" : "ink";
const wrap = heroOverlay ? "absolute inset-x-0 top-0 z-50" : "sticky top-0 z-50 bg-bg";
const linkBase = heroOverlay ? "text-white/75 hover:text-white" : "text-text-muted hover:text-text";
const linkActive = heroOverlay ? "text-white" : "text-text";
const ctrl = heroOverlay ? "text-white/80 hover:text-white" : "text-text-muted hover:text-text";
---
<header class:list={[wrap, "w-full"]}>
  <div class="mx-auto max-w-[1100px] px-6 py-6">
    <div class="flex items-center justify-between gap-4 sm:justify-normal sm:gap-8">
      <span class="sm:mr-auto"><Monogram tone={tone} /></span>
      <nav aria-label="Primary" class="hidden items-center gap-7 sm:flex">
        {links.map((l) => (
          <a href={l.href} aria-current={isActive(l.href) ? "page" : undefined}
             class:list={["text-xs uppercase tracking-[0.16em] transition-colors", isActive(l.href) ? linkActive : linkBase]}>{l.label}</a>
        ))}
      </nav>
      <div class="flex items-center gap-3">
        <ThemeToggle />
        <button id="cube-trigger" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="cube-menu" aria-label="Open menu" class:list={["rounded-md border border-border p-2 transition-colors", ctrl]}>
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </button>
      </div>
    </div>
    <nav aria-label="Primary" class="mt-4 flex flex-wrap gap-x-5 gap-y-2 sm:hidden">
      {links.map((l) => (
        <a href={l.href} aria-current={isActive(l.href) ? "page" : undefined}
           class:list={["text-xs uppercase tracking-[0.16em]", isActive(l.href) ? linkActive : linkBase]}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>
