---
interface Props { class?: string; }
const { class: cls = "" } = Astro.props;
---
<canvas aria-hidden="true" class:list={["sunflower-canvas block h-full w-full", cls]}></canvas>
<script>
  import { initSunflower } from "../scripts/sunflower";
  document.querySelectorAll(".sunflower-canvas").forEach((c) => {
    if (c instanceof HTMLCanvasElement && !c.dataset.sfInit) {
      c.dataset.sfInit = "1";
      initSunflower(c);
    }
  });
</script>
