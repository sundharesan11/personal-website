---
// src/components/Kicker.astro
// Small letter-spaced eyebrow label used above page titles and in section heads.
interface Props { text: string; tone?: "default" | "accent"; }
const { text, tone = "default" } = Astro.props;
const color = tone === "accent" ? "text-accent" : "text-text-muted";
---
<span class={`block text-xs uppercase tracking-kicker ${color}`}>{text}</span>
