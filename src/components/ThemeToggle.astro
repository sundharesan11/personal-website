---
---
<button
  id="theme-toggle"
  type="button"
  aria-label="Switch theme"
  class="rounded-md border border-border p-2 text-text-muted transition-colors duration-200 hover:text-text hover:border-text-muted"
>
  <svg class="ti-light size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5L19 19M19 5l-1.5 1.5M6.5 17.5L5 19"/></svg>
  <svg class="ti-dark size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/></svg>
  <svg class="ti-cream size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M17 18a5 5 0 00-10 0"/><path d="M12 2v7M4.2 10.2l1.4 1.4M1 18h2M21 18h2M18.4 11.6l1.4-1.4M23 22H1"/></svg>
</button>
<script>
  import { initToggle } from "../scripts/theme";
  const btn = document.getElementById("theme-toggle");
  if (btn) initToggle(btn);
</script>
<style is:global>
  #theme-toggle .ti-dark, #theme-toggle .ti-cream { display: none; }
  :root.dark #theme-toggle .ti-light { display: none; }
  :root.dark #theme-toggle .ti-dark { display: inline; }
  :root.theme-cream #theme-toggle .ti-light { display: none; }
  :root.theme-cream #theme-toggle .ti-cream { display: inline; }
</style>
