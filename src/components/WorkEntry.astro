---
interface Props { href: string; title: string; summary: string; index: number; image: string; year?: number; }
const { href, title, summary, index, image, year } = Astro.props;
const num = String(index).padStart(2, "0");
const imageRight = index % 2 === 1;
---
<a href={href} class="group block py-10">
  <div class="grid items-center gap-6 sm:gap-10 md:grid-cols-2">
    <div class:list={["h-[46vw] max-h-[520px] min-h-[260px] w-full bg-cover bg-center bg-fixed", imageRight ? "md:order-last" : ""]} style={`background-image:url('${image}')`} role="img" aria-label={`${title} cover`}></div>
    <div>
      <div class="font-sans text-sm uppercase tracking-[0.18em] text-stellar">nº {num}</div>
      <h3 class="mt-3 font-serif font-semibold leading-[1.02] text-text transition-colors group-hover:text-accent" style="font-size: clamp(2rem, 4.5vw, 3.4rem);">{title}</h3>
      <p class="mt-4 max-w-[42ch] text-text-muted">{summary}{year ? <span class="whitespace-nowrap"> — {year}</span> : null}</p>
    </div>
  </div>
</a>
