---
interface Props { image?: string; kicker?: string; }
const { image = "/img/hero.jpg", kicker = "Designer & builder — portfolio 2026" } = Astro.props;
---
<section class="relative left-1/2 right-1/2 -mx-[50vw] w-screen overflow-hidden bg-fixed bg-cover bg-center" style={`min-height:92vh; background-image: linear-gradient(to top, rgba(0,0,0,.74), rgba(0,0,0,.18) 55%, rgba(0,0,0,.5)), url('${image}')`}>
  <div class="mx-auto flex max-w-[1100px] flex-col justify-end px-6 pb-16" style="min-height:92vh; padding-top:7rem;">
    <p class="font-sans text-xs uppercase tracking-[0.2em] text-white/80">{kicker}</p>
    <h1 class="mt-5 font-serif font-semibold leading-[0.9] text-white" style="font-size: clamp(2.8rem, 10vw, 7rem);">Sundharesan<br />Kumaresan</h1>
  </div>
</section>
