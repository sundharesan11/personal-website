---
interface Props { image?: string; kicker?: string; lines?: string[]; }
const { image = "/img/hero.jpg", kicker = "AI engineer · writer", lines = [] } = Astro.props;
---
<section class="grid w-full md:min-h-[90vh] md:grid-cols-2">
  <div class="order-2 flex flex-col justify-center px-6 py-12 sm:px-10 md:order-1 md:py-0 md:pl-[max(1.5rem,8vw)] md:pr-12">
    <p class="font-sans text-xs uppercase tracking-[0.2em] text-accent">{kicker}</p>
    <h1 class="mt-5 font-serif font-semibold leading-[0.92] text-text" style="font-size: clamp(2rem, 5vw, 4rem);">Sundharesan<br />Kumaresan</h1>
    {lines.length > 0 && (
      <ul class="mt-7 max-w-[34ch] space-y-1.5">
        {lines.map((l) => (
          <li class="font-serif leading-snug text-text-muted" style="font-size: clamp(1.05rem, 1.6vw, 1.35rem);">{l}</li>
        ))}
      </ul>
    )}
  </div>
  <div class="relative order-1 min-h-[58vh] md:order-2 md:min-h-0">
    <img src={image} alt="Sundharesan Kumaresan" class="absolute inset-0 h-full w-full object-cover object-[center_22%]" />
  </div>
</section>
