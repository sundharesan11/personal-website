---
// src/components/PageHeader.astro
// The canonical page masthead: muted label left, accent label right, optional
// display title. Every section page opens with this.
interface Props {
  left: string;
  right?: string;
  title?: string;
  titleMotion?: "tracking" | "scale";
}
const { left, right, title, titleMotion = "tracking" } = Astro.props;
---
<header data-reveal class="pt-5">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <span class="label-fit font-sans text-xs uppercase tracking-kicker text-text-muted">{left}</span>
    {right && <span class="label-fit font-sans text-xs uppercase tracking-kicker text-accent">{right}</span>}
  </div>
  {title && (
    <h1
      data-reveal
      class:list={[
        "mt-5 font-serif font-semibold leading-[0.9] text-display-hero",
        titleMotion === "scale" ? "reveal-scale" : "reveal-tracking",
      ]}
    >{title}</h1>
  )}
  <slot />
</header>
