---
const path = Astro.url.pathname;
const links = [
  { href: "/", label: "Home", face: "f-front" },
  { href: "/work", label: "Now / Work", face: "f-right" },
  { href: "/writing", label: "Writing", face: "f-back" },
  { href: "/reading", label: "Reading", face: "f-left" },
  { href: "/ambitions", label: "Ambitions", face: "f-top" },
  { href: "/about", label: "About", face: "f-bottom" },
];
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---
<div id="cube-menu" class="hidden fixed inset-0 z-[100]">
  <div id="cube-backdrop" class="absolute inset-0 bg-black/55"></div>
  <aside class="cube-panel absolute right-0 top-0 flex h-full w-[min(460px,90vw)] flex-col items-center justify-center gap-10 bg-[#0B0B0C] px-8" role="dialog" aria-modal="true" aria-label="Site menu">
    <button id="cube-close" type="button" aria-label="Close menu" class="absolute right-6 top-6 text-3xl leading-none text-white/80 transition-colors hover:text-white">&times;</button>
    <div class="cube-scene" aria-hidden="true">
      <div id="cube" class="cube">
        {links.map((l) => (<span class:list={["cube-face", l.face, isActive(l.href) && "is-active"]}>{l.label}</span>))}
      </div>
    </div>
    <p class="font-sans text-xs uppercase tracking-[0.18em] text-white/40" aria-hidden="true">Drag to explore</p>
    <nav aria-label="Menu" class="flex flex-col items-center gap-3">
      {links.map((l) => (
        <a href={l.href} aria-current={isActive(l.href) ? "page" : undefined}
           class:list={["font-serif text-2xl transition-colors", isActive(l.href) ? "text-stellar" : "text-white/85 hover:text-stellar"]}>{l.label}</a>
      ))}
    </nav>
  </aside>
</div>
<style>
  .cube-panel { transform: translateX(100%); transition: transform .42s cubic-bezier(.2,.7,.2,1); box-shadow: -24px 0 60px rgba(0,0,0,0.5); }
  #cube-menu.is-open .cube-panel { transform: none; }
  .cube-scene { perspective: 900px; width: 180px; height: 180px; cursor: grab; }
  .cube-scene:active { cursor: grabbing; }
  .cube { position: relative; width: 180px; height: 180px; transform-style: preserve-3d; transform: rotateX(-18deg) rotateY(-28deg); }
  .cube-face { position: absolute; width: 180px; height: 180px; display: flex; align-items: center; justify-content: center; border: 1px solid color-mix(in srgb, var(--color-stellar) 50%, transparent); background: rgba(14,14,20,0.66); font-family: var(--font-serif); font-size: 1.25rem; color: #fff; text-align: center; padding: 0 10px; }
  .cube-face.is-active { border-color: var(--color-stellar); background: color-mix(in srgb, var(--color-stellar) 26%, rgba(10,10,14,0.7)); color: var(--color-stellar); }
  .f-front { transform: rotateY(0deg) translateZ(90px); }
  .f-back { transform: rotateY(180deg) translateZ(90px); }
  .f-right { transform: rotateY(90deg) translateZ(90px); }
  .f-left { transform: rotateY(-90deg) translateZ(90px); }
  .f-top { transform: rotateX(90deg) translateZ(90px); }
  .f-bottom { transform: rotateX(-90deg) translateZ(90px); }
  @media (prefers-reduced-motion: reduce) {
    .cube-panel { transition: none; transform: none; }
  }
</style>
<script>
  import { initCube } from "../scripts/cube";
  initCube();
</script>
