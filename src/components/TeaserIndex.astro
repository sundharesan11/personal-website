---
interface Props { items: { href: string; label: string; hook: string; n: number }[]; }
const { items } = Astro.props;
---
<ul class="border-t-2 border-stellar">
  {items.map((it) => (
    <li class="border-b border-border">
      <a href={it.href} class="group block py-7">
        <div class="flex items-baseline gap-4">
          <span class="font-sans text-sm uppercase tracking-[0.18em] text-accent">nº {String(it.n).padStart(2, "0")}</span>
          <h3 class="font-serif font-semibold leading-[1.05] transition-colors group-hover:text-accent" style="font-size: clamp(1.8rem, 4.5vw, 3rem);">{it.label}</h3>
        </div>
        <p class="mt-1 text-text-muted">{it.hook}</p>
      </a>
    </li>
  ))}
</ul>
