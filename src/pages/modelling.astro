---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
const shoots = (await getCollection("modelling")).sort((a, b) => a.data.order - b.data.order);
const hero = shoots.find((s) => s.data.featured) ?? shoots[0];
const rest = shoots.filter((s) => s.id !== hero?.id);
const credit = (d: any) => [d.brand, d.photographer ? `ph. ${d.photographer}` : null, d.location, d.year].filter(Boolean).join(" · ");
---
<BaseLayout title="Modelling · Sundharesan Kumaresan" heroOverlay>
  <section class="relative left-1/2 right-1/2 -mx-[50vw] w-screen overflow-hidden bg-cover bg-center" style={`min-height:78vh; background-image: linear-gradient(to top, rgba(0,0,0,.7), rgba(0,0,0,.1) 55%, rgba(0,0,0,.45)), url('${hero?.data.image ?? "/img/hero.jpg"}')`}>
    <div class="mx-auto flex max-w-[1100px] flex-col justify-end px-6 pb-12" style="min-height:78vh; padding-top:7rem;">
      <p class="font-sans text-xs uppercase tracking-[0.2em] text-stellar">In front of the camera</p>
      <h1 class="mt-3 font-serif font-semibold leading-[0.92] text-white" style="font-size: clamp(3rem, 12vw, 8rem);">Modelling</h1>
      {hero && <p class="mt-4 text-xs uppercase tracking-[0.16em] text-white/70">{credit(hero.data)}</p>}
    </div>
  </section>
  <main id="main-content" class="mx-auto max-w-[1100px] px-6 py-16">
    <p data-reveal class="max-w-[28ch] font-serif font-semibold leading-[1.05]" style="font-size: clamp(1.8rem, 5vw, 3rem);">The same face that stares down hard problems, occasionally stares down a camera instead.</p>
    <p data-reveal class="mt-6 max-w-[60ch] text-lg leading-relaxed text-text-muted">Less debugging, more standing very still and pretending I planned this. Editorial, campaign, and the odd experiment. A different kind of build.</p>

    <div class="mt-16 flex flex-col gap-20">
      {rest.map((s, i) => (
        <figure data-reveal class:list={["", i % 2 === 1 && "md:ml-auto md:max-w-[78%]"]}>
          <img src={s.data.image} alt={s.data.title ?? "Shoot"} loading="lazy" class="w-full" />
          <figcaption class="mt-3 text-xs uppercase tracking-[0.14em] text-text-muted">{s.data.title ? `${s.data.title} · ` : ""}{credit(s.data)}</figcaption>
        </figure>
      ))}
    </div>
    <p class="mt-12 text-xs text-text-muted">Placeholder frames. Swap for your real shoots in src/content/modelling.</p>
  </main>
</BaseLayout>
