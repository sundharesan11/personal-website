---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sunflower from "../../components/Sunflower.astro";
import IndexNo from "../../components/IndexNo.astro";
import NextPageLink from "../../components/NextPageLink.astro";
import { getCollection } from "astro:content";
import { lenses, lensIntro, scatter, linkOf, metaOf, nextLens } from "../../lib/writing";

export async function getStaticPaths() {
  const all = await getCollection("writing", ({ data }) => !data.draft);
  return lenses
    .filter((l) => all.some((p) => p.data.lens === l.key))
    .map((l) => ({ params: { lens: l.key }, props: { lens: l } }));
}
const { lens } = Astro.props;
const posts = (await getCollection("writing", ({ data }) => !data.draft && data.lens === lens.key))
  .sort((a, b) => {
    const rank = (s: string) => (s === "published" ? 0 : 1);
    const d = rank(a.data.status) - rank(b.data.status);
    return d !== 0 ? d : b.data.date.valueOf() - a.data.date.valueOf();
  });
const isTech = lens.key === "technical";
const next = nextLens(lens.key);
---
<BaseLayout
  title={`${lens.label} · Writing · Sundharesan Kumaresan`}
  description={lensIntro[lens.key]}
>
  <main id="main-content" class="relative mx-auto max-w-page px-6 pt-16 pb-16">
    <div class="md:grid md:grid-cols-[minmax(0,1fr)_300px] md:gap-12">
      <div>
        <div>
          <a href="/writing" class="font-sans text-xs uppercase tracking-kicker text-text-muted transition-colors hover:text-text">&larr; Writing</a>
          <h1 data-reveal class="reveal-tracking mt-3 font-serif text-display-page font-semibold leading-[0.95]">{lens.label}</h1>
        </div>
        <p class="mt-6 max-w-[60ch] text-lg leading-relaxed text-text-muted">{lensIntro[lens.key]}</p>

        <div class="mt-12 flex flex-col gap-10 border-t border-border pt-10">
          {posts.map((post, i) => {
            const L = scatter[i % scatter.length];
            const link = linkOf(post);
            return (
              <article class:list={["max-w-[58ch]", link && "transition-transform duration-300 hover:-translate-y-1", L.ml, L.w]}>
                <a href={link ?? undefined} target={post.data.link ? "_blank" : undefined} rel={post.data.link ? "noopener noreferrer" : undefined} class:list={["group block", !link && "pointer-events-none"]}>
                  <div class="flex items-baseline gap-4">
                    <IndexNo n={i + 1} />
                    <span class="text-sm uppercase tracking-dateline text-text-muted">{metaOf(post)}</span>
                  </div>
                  <h2 class:list={["mt-1 font-serif text-list-title font-semibold leading-[1.06]", link && "transition-colors group-hover:text-accent"]}>{post.data.title}</h2>
                  <p class="mt-1 text-text-muted">{post.data.description}</p>
                </a>
              </article>
            );
          })}
        </div>

        <div class="mt-16">
          {isTech && (
            <p class="text-sm text-text-muted">More on <a href="https://medium.com/@sundharesansk11" target="_blank" rel="noopener noreferrer" class="u-draw text-text">Medium &#8599;</a></p>
          )}
          <NextPageLink href={`/writing/${next.key}`} eyebrow="Next lens">{next.label}</NextPageLink>
        </div>
      </div>
      <div class="hidden md:block" aria-hidden="true">
        <div class="pointer-events-none sticky top-28">
          <div class="h-[clamp(280px,42vh,440px)] w-full opacity-85"><Sunflower /></div>
          <div class="mt-[10vh] ml-auto h-[clamp(140px,21vh,220px)] w-[52%] opacity-60"><Sunflower /></div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
