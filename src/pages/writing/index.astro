---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Kicker from "../../components/Kicker.astro";
import { getCollection } from "astro:content";
import { lenses, lensIntro, linkOf } from "../../lib/writing";

const all = (await getCollection("writing", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = all.find((p) => p.data.featured);
const count = (key: string) => all.filter((p) => p.data.lens === key).length;
const activeLenses = lenses.filter((l) => count(l.key) > 0);
---
<BaseLayout title="Writing · Sundharesan Kumaresan">
  <main id="main-content" class="mx-auto max-w-[1100px] px-6 pt-16 pb-16">
    <Kicker text="Notes" />
    <h1 class="mt-3 font-serif font-semibold leading-[0.95]" style="font-size: clamp(3rem, 9vw, 6rem);">Writing</h1>
    <p class="mt-6 max-w-[58ch] text-lg leading-relaxed text-text-muted">I write to find out what I actually think. Three things keep dragging me back: the stories we tell, the systems that decide who gets seen, and the machines we're building in the middle of it all. Different lenses, same stubborn question.</p>

    {featured && (
      <a href={linkOf(featured)} target={featured.data.link ? "_blank" : undefined} rel={featured.data.link ? "noopener noreferrer" : undefined} class="group mt-14 block border-t-2 border-stellar pt-8">
        <div class="font-sans text-sm uppercase tracking-[0.18em] text-stellar">{featured.data.link ? "Featured · Read on Medium ↗" : "Featured"}</div>
        <h2 class="mt-2 font-serif font-semibold leading-[1.02] transition-colors group-hover:text-accent" style="font-size: clamp(2rem, 5vw, 3.4rem);">{featured.data.title}</h2>
        <p class="mt-2 max-w-[60ch] text-text-muted">{featured.data.description}</p>
      </a>
    )}

    <section class="mt-12">
      {activeLenses.map((l) => (
        <a href={`/writing/${l.key}`} class="group block border-t border-border py-10">
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
            <h2 class="font-serif font-semibold leading-[1.0] transition-colors group-hover:text-accent" style="font-size: clamp(2rem, 6vw, 3.6rem);">{l.label}</h2>
            <span class="font-sans text-xs uppercase tracking-[0.16em] text-stellar">{count(l.key)} {count(l.key) === 1 ? "piece" : "pieces"} &rarr;</span>
          </div>
          <p class="mt-3 max-w-[62ch] text-text-muted">{lensIntro[l.key]}</p>
        </a>
      ))}
    </section>
  </main>
</BaseLayout>
