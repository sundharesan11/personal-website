---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { getCollection } from "astro:content";
import { lenses, lensIntro } from "../../lib/writing";
import { withBase } from "../../lib/paths";

const all = await getCollection("writing", ({ data }) => !data.draft);
// Honest counts: published pieces are pieces; forming pieces are forming.
const countOf = (key: string) => {
  const published = all.filter((p) => p.data.lens === key && p.data.status === "published").length;
  const forming = all.filter((p) => p.data.lens === key && p.data.status === "writing").length;
  const parts = [];
  if (published > 0) parts.push(`${published} ${published === 1 ? "piece" : "pieces"}`);
  if (forming > 0) parts.push(`${forming} forming`);
  return parts.join(" · ");
};
const activeLenses = lenses.filter((l) => all.some((p) => p.data.lens === l.key));
---
<BaseLayout
  title="Writing · Sundharesan Kumaresan"
  description="Fiction, economics, and the machines in between. Three lenses on one stubborn question: who gets seen."
>
  <main id="main-content" class="mx-auto max-w-page px-6 pt-16 pb-16">
    <PageHeader left="The writing desk" right="Three lenses" title="Writing">
      <p class="mt-7 max-w-[58ch] text-lg leading-relaxed text-text-muted">I write to find out what I actually think. Three things keep dragging me back: the stories we tell, the systems that decide who gets seen, and the machines we're building in the middle of it all. Different lenses, same stubborn question.</p>
    </PageHeader>

    <section class="mt-14">
      {activeLenses.map((l) => (
        <a href={withBase(`/writing/${l.key}`)} class="group block border-t border-border py-10">
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
            <h2 class="swap-italic font-serif text-entry font-semibold leading-[1.0]">
              <span class="si-roman">{l.label}</span>
              <span class="si-italic" aria-hidden="true">{l.label}</span>
            </h2>
            <span class="adv-label font-sans text-xs uppercase tracking-kicker text-accent">{countOf(l.key)} <span class="adv-arrow">&rarr;</span></span>
          </div>
          <p class="mt-3 max-w-[62ch] text-text-muted">{lensIntro[l.key]}</p>
        </a>
      ))}
    </section>
  </main>
</BaseLayout>
