---
import BaseLayout from "../layouts/BaseLayout.astro";
import Kicker from "../components/Kicker.astro";
---
<BaseLayout title="About — Sundharesan Kumaresan">
  <main id="main-content" class="mx-auto max-w-[1100px] px-6 pt-16 pb-8">
    <div class="grid gap-10 md:grid-cols-2 md:gap-14">
      <div>
        <Kicker text="About" />
        <h1 class="mt-3 font-serif font-semibold leading-[0.95]" style="font-size: clamp(2.6rem, 7vw, 4.5rem);">Sundharesan Kumaresan</h1>
        <div class="mt-8 max-w-[46ch] space-y-5 text-lg leading-relaxed text-text-muted">
          <p>Placeholder bio. Sundharesan is a designer &amp; builder of quiet, considered software — replace this with the real story: background, what he cares about, how to work with him.</p>
          <p>Replace with a second paragraph of real biography.</p>
        </div>
      </div>
      <div class="h-[60vw] max-h-[640px] min-h-[360px] w-full bg-cover bg-center bg-fixed md:order-first" style="background-image:url('/img/about.jpg')" role="img" aria-label="Portrait of Sundharesan Kumaresan"></div>
    </div>
    <blockquote class="mt-20 max-w-[22ch] border-l-2 border-stellar pl-6 font-serif font-semibold leading-[1.05]" style="font-size: clamp(1.8rem, 5vw, 3rem);">
      &ldquo;Subtraction is the hardest part of design.&rdquo;
    </blockquote>
  </main>
</BaseLayout>
