---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Prose from "../../components/Prose.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const cover = project.data.cover ?? "/img/hero.jpg";
const fmt = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---
<BaseLayout title={`${project.data.title} — Sundharesan Kumaresan`} description={project.data.summary} heroOverlay>
  <section class="relative left-1/2 right-1/2 -mx-[50vw] w-screen overflow-hidden bg-fixed bg-cover bg-center" style={`min-height:70vh; background-image: linear-gradient(to top, rgba(0,0,0,.78), rgba(0,0,0,.25) 60%, rgba(0,0,0,.5)), url('${cover}')`}>
    <div class="mx-auto flex max-w-[1100px] flex-col justify-end px-6 pb-14" style="min-height:70vh; padding-top:7rem;">
      <p class="font-sans text-xs uppercase tracking-[0.2em] text-stellar">Project</p>
      <h1 class="mt-4 font-serif font-semibold leading-[0.95] text-white" style="font-size: clamp(2.4rem, 8vw, 5rem);">{project.data.title}</h1>
      <p class="mt-4 text-sm uppercase tracking-[0.14em] text-white/80">{fmt(project.data.date)}</p>
    </div>
  </section>
  <main id="main-content" class="mx-auto max-w-[1100px] px-6 py-16">
    <p class="mx-auto mb-10 text-lg text-text-muted" style="max-width: var(--measure)">{project.data.summary}</p>
    <Prose dropcap><Content /></Prose>
    {project.data.url && (
      <div class="mx-auto mt-12" style="max-width: var(--measure)">
        <a href={project.data.url} class="u-underline text-accent">Visit the project ↗</a>
      </div>
    )}
    <div class="mx-auto mt-16" style="max-width: var(--measure)">
      <a href="/work" class="text-xs uppercase tracking-[0.16em] text-text-muted hover:text-text">← Work</a>
    </div>
  </main>
</BaseLayout>
