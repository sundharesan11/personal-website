---
import BaseLayout from "../../layouts/BaseLayout.astro";

const ambitions = [
  {
    href: "/to/agri-fintech",
    tag: "A venture",
    title: "A farmer capital network",
    dek: "Capital and logistics reaching farmers directly, on terms that fit how a farm actually works. Strip it down and the whole thing rests on trust.",
  },
  {
    href: "/to/sports-development",
    tag: "A lifetime's work",
    title: "Sports development in India",
    dek: "A billion people, a handful of medals. Finding the talent the system never sees, and building the ladder it never had.",
  },
];
---
<BaseLayout title="To · Sundharesan Kumaresan">
  <main id="main-content" class="mx-auto max-w-[1100px] px-6 pt-16 pb-16">
    <header>
      <p class="font-sans text-xs uppercase tracking-[0.18em] text-text-muted">The future desk</p>
      <div class="mt-5 flex items-end gap-5">
        <h1 class="font-serif font-semibold leading-[0.78]" style="font-size: clamp(3.5rem, 13vw, 8.5rem);">To</h1>
        <span class="mb-[0.7rem] h-px flex-1 bg-stellar"></span>
        <span class="mb-[0.9rem] whitespace-nowrap font-sans text-xs uppercase tracking-[0.18em] text-stellar">Forming</span>
      </div>
      <p data-reveal class="mt-8 max-w-[22ch] font-serif font-semibold leading-[1.05]" style="font-size: clamp(1.7rem, 4.5vw, 2.8rem);">Things I intend to build. All of them.</p>
    </header>

    <section class="mt-14">
      {ambitions.map((a) => (
        <a href={a.href} class="group block border-t border-border py-10">
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
            <h2 class="font-serif font-semibold leading-[1.0] transition-colors group-hover:text-accent" style="font-size: clamp(2rem, 6vw, 3.6rem);">{a.title}</h2>
            <span class="font-sans text-xs uppercase tracking-[0.18em] text-stellar">{a.tag} &rarr;</span>
          </div>
          <p class="mt-3 max-w-[62ch] text-text-muted">{a.dek}</p>
        </a>
      ))}
    </section>
  </main>
</BaseLayout>
