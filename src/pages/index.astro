---
import BaseLayout from "../layouts/BaseLayout.astro";
import FixedPhotoHero from "../components/FixedPhotoHero.astro";

const contents = [
  { href: "/work", title: "Now / Work", teaser: "The day job, minus the gloss: AI products, built end to end." },
  { href: "/writing", title: "Writing", teaser: "Fiction, economics, and the machines in between." },
  { href: "/reading", title: "Reading", teaser: "The books that did the most damage to how I think." },
  { href: "/to", title: "To", teaser: "The things I haven't built yet, and what I'd have to prove before I do." },
  { href: "/modelling", title: "Modelling", teaser: "Not a model yet. A standing desire to give it an honest shot someday." },
  { href: "/about", title: "About", teaser: "The long version, where it all turns out to be one story, not three." },
];
---
<BaseLayout title="Sundharesan Kumaresan">
  <FixedPhotoHero
    image="/img/hero-crop.jpeg"
    alt="Sundharesan Kumaresan"
    fit="contain"
    backgroundSize="auto calc(100% - 28px)"
    objectPosition="right 18px"
  >
    <p class="label-fit font-sans text-xs uppercase tracking-[0.2em] text-accent">AI engineer &middot; writer &middot; Oogway Labs</p>
    <h1 class="display-fit mt-5 font-serif font-semibold leading-[0.92] text-text" style="font-size: clamp(2rem, 5vw, 4rem);">Sundharesan<br />Kumaresan</h1>
  </FixedPhotoHero>
  <main id="main-content" class="relative z-10 bg-bg">
    <div class="mx-auto max-w-[1100px] px-6">

    <section class="py-20 md:py-28">
      <p class="font-sans text-xs uppercase tracking-[0.2em] text-accent">From the desk</p>
      <div class="mt-6 grid gap-10 md:grid-cols-[1.5fr_0.5fr] md:gap-16">
        <div class="dropcap max-w-[60ch] text-lg leading-[1.8] text-text-muted">
          <p>I'm an AI engineer. I take something half-defined and slightly impossible and turn it into a real thing people use, the architecture, the build, the whole thing, usually faster than is strictly advisable. I love it, which probably says more about me than the work. I write fiction too, not as often as I'd like, usually when there's something I'm trying to work out on the page. Lately I've also been knee-deep in economics, logistics, and the psychology underneath both, partly because the products that actually land are built on how people think, mostly because people are the most interesting puzzle going. And under all of it, the same fixation: who a system treats as real, and who it quietly writes off.</p>
        </div>
        <aside class="md:border-l md:border-border md:pl-10">
          <p class="font-serif leading-[1.1]" style="font-size: clamp(1.4rem, 3vw, 2rem);">Engineer first. Hopelessly curious after that.</p>
        </aside>
      </div>
    </section>

    <section class="border-t border-border py-16">
      <div class="flex items-baseline justify-between border-b border-border pb-3">
        <h2 class="font-serif font-semibold" style="font-size: clamp(1.4rem, 3.4vw, 1.95rem);">Inside</h2>
        <span class="font-sans text-xs uppercase tracking-[0.16em] text-text-muted">The contents</span>
      </div>
      <div>
        {contents.map((c, i) => (
          <a href={c.href} class="group block border-b border-border py-8">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <h3 class="font-serif font-semibold leading-[1.0] transition-colors group-hover:text-accent" style="font-size: clamp(1.5rem, 4vw, 2.4rem);">{c.title}</h3>
              <span class="font-sans text-xs uppercase tracking-[0.16em] text-accent">n&ordm; {String(i + 1).padStart(2, "0")} &rarr;</span>
            </div>
            <p class="mt-2 max-w-[62ch] text-text-muted">{c.teaser}</p>
          </a>
        ))}
      </div>
    </section>
    </div>
  </main>
</BaseLayout>
