---
import BaseLayout from "../layouts/BaseLayout.astro";
import ParallaxHero from "../components/ParallaxHero.astro";

const contents = [
  { href: "/work", title: "Now / Work", teaser: "What happens when someone hands me a hard problem and a deadline that was already yesterday." },
  { href: "/writing", title: "Writing", teaser: "Fiction, economics, and the machines in between. Three lenses, one stubborn question." },
  { href: "/reading", title: "Reading", teaser: "The books that rewired how I think about who a system leaves out." },
  { href: "/to", title: "To", teaser: "Things I intend to build: a capital network for farmers, a future for Indian sport." },
  { href: "/modelling", title: "Modelling", teaser: "The same face that stares down bugs, occasionally in front of a camera." },
  { href: "/about", title: "About", teaser: "The long version, where the engineer and the writer turn out to be the same person." },
];
---
<BaseLayout title="Sundharesan Kumaresan">
  <ParallaxHero
    image="/img/hero-crop.png"
    kicker="AI engineer · writer · Oogway Labs"
    lines={[
      "Forward-deployed engineer by day.",
      "Writer of fiction by night.",
      "Building things for farmers and athletes in between.",
    ]}
  />
  <main id="main-content" class="mx-auto max-w-[1100px] px-6">

    <section class="py-20 md:py-28">
      <p class="font-sans text-xs uppercase tracking-[0.2em] text-stellar">From the desk</p>
      <div class="mt-6 grid gap-10 md:grid-cols-[1.5fr_0.5fr] md:gap-16">
        <div class="dropcap max-w-[60ch] text-lg leading-[1.8] text-text-muted">
          <p>I build AI for a living: someone shows up with a hard problem and a deadline that was already yesterday, and I turn it into something that actually ships. Then I go home and write fiction. In between I read about economies and the people they overlook, and I'm slowly building ventures for exactly those people. It all comes back to one question: who a system sees, and who it quietly leaves out.</p>
        </div>
        <aside class="md:border-l md:border-border md:pl-10">
          <p class="font-serif leading-[1.1]" style="font-size: clamp(1.5rem, 3.2vw, 2.2rem);">An engineer who tells stories, and a storyteller who ships.</p>
        </aside>
      </div>
    </section>

    <section class="border-t border-border py-16">
      <div class="flex items-baseline justify-between border-b border-border pb-3">
        <h2 class="font-serif font-semibold" style="font-size: clamp(1.6rem, 4vw, 2.4rem);">Inside</h2>
        <span class="font-sans text-xs uppercase tracking-[0.16em] text-text-muted">The contents</span>
      </div>
      <div>
        {contents.map((c, i) => (
          <a href={c.href} class="group block border-b border-border py-8">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <h3 class="font-serif font-semibold leading-[1.0] transition-colors group-hover:text-accent" style="font-size: clamp(1.8rem, 5vw, 3rem);">{c.title}</h3>
              <span class="font-sans text-xs uppercase tracking-[0.16em] text-stellar">n&ordm; {String(i + 1).padStart(2, "0")} &rarr;</span>
            </div>
            <p class="mt-2 max-w-[62ch] text-text-muted">{c.teaser}</p>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
