---
import BaseLayout from "../layouts/BaseLayout.astro";
import ParallaxHero from "../components/ParallaxHero.astro";
import { getCollection } from "astro:content";

const gallery = await getCollection("gallery");
const frames = gallery
  .filter((g) => g.data.kind === "frame")
  .sort((a, b) => a.data.order - b.data.order);
const doodles = gallery
  .filter((g) => g.data.kind === "doodle")
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Sundharesan Kumaresan">
  <ParallaxHero image="/img/hero.jpg" />
  <main id="main-content" class="mx-auto max-w-[1100px] px-6">

    <section class="py-20 md:py-28">
      <p class="font-sans text-xs uppercase tracking-[0.2em] text-stellar">From the desk</p>
      <div class="mt-6 grid gap-10 md:grid-cols-[1.5fr_0.5fr] md:gap-16">
        <div class="dropcap max-w-[60ch] text-lg leading-[1.8] text-text-muted">
          <p>Placeholder context. An AI engineer who writes, and a writer who draws: words, code, and doodles made by the same hand. Replace this with the real lead: who you are, what you're chasing, and why this place exists. Keep it personal; it sets the voice for everything else.</p>
        </div>
        <aside class="md:border-l md:border-border md:pl-10">
          <p class="font-serif leading-[1.1]" style="font-size: clamp(1.5rem, 3.2vw, 2.2rem);">&ldquo;A standfirst, one line that makes a stranger want to stay.&rdquo;</p>
        </aside>
      </div>
    </section>

    <section class="py-16">
      <div class="flex items-baseline justify-between border-b border-border pb-3">
        <h2 class="font-serif font-semibold" style="font-size: clamp(1.8rem, 5vw, 3rem);">Frames I keep</h2>
        <span class="font-sans text-xs uppercase tracking-[0.16em] text-text-muted">What I'm looking at</span>
      </div>
      <div class="mt-10 columns-2 gap-4 md:columns-3 md:gap-6 [&>figure]:mb-4 md:[&>figure]:mb-6">
        {frames.map((f) => (
          <figure class="break-inside-avoid">
            <img src={f.data.image} alt="" loading="lazy" class="w-full" />
            <figcaption class="mt-2 text-xs uppercase tracking-[0.12em] text-text-muted">{f.data.caption}{f.data.credit ? ` · ${f.data.credit}` : ""}</figcaption>
          </figure>
        ))}
      </div>
      <p class="mt-6 text-xs text-text-muted">Placeholder imagery. Swap for your own film stills or licensed images.</p>
    </section>

    <section class="py-16">
      <div class="flex items-baseline justify-between border-b border-stellar pb-3">
        <h2 class="font-serif font-semibold" style="font-size: clamp(1.8rem, 5vw, 3rem);">From the sketchbook</h2>
        <a href="#" class="u-draw font-sans text-xs uppercase tracking-[0.16em] text-stellar">@inked doodler</a>
      </div>
      <div class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-3 md:gap-6">
        {doodles.map((d) => (
          <figure>
            <img src={d.data.image} alt="" loading="lazy" class="w-full" />
            <figcaption class="mt-2 text-xs uppercase tracking-[0.12em] text-text-muted">{d.data.caption}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="border-t border-border py-20">
      <p class="max-w-[34ch] font-serif leading-[1.15]" style="font-size: clamp(1.8rem, 5vw, 2.8rem);">More inside: <a href="/work" class="u-draw">the work</a>, <a href="/writing" class="u-draw">the writing</a>, <a href="/reading" class="u-draw">the reading</a>, <a href="/modelling" class="u-draw">the camera</a>, and <a href="/to" class="u-draw">what's forming</a>.</p>
    </section>
  </main>
</BaseLayout>
