---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Kicker from "../../components/Kicker.astro";
import { getCollection } from "astro:content";

const books = (await getCollection("reading")).sort((a, b) => a.data.order - b.data.order);
const groups = [...new Set(books.map((b) => b.data.opened))];
---
<BaseLayout title="Reading · Sundharesan Kumaresan">
  <main id="main-content" class="mx-auto max-w-[1100px] px-6 pt-16 pb-16">
    <Kicker text="The reading room" />
    <h1 class="mt-3 font-serif font-semibold leading-[0.95]" style="font-size: clamp(3rem, 9vw, 6rem);">Reading</h1>
    {groups.map((g) => (
      <section class="mt-16">
        <h2 class="font-sans text-sm uppercase tracking-[0.18em] text-text-muted">{g}</h2>
        <div class="mt-8 flex flex-col gap-12">
          {books.filter((b) => b.data.opened === g).map((b, i) => (
            <article class:list={["max-w-[58ch] transition-transform duration-300 hover:-translate-y-1", i % 3 === 1 ? "md:ml-[20%]" : i % 3 === 2 ? "md:ml-[9%]" : ""]}>
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                <h3 class="font-serif font-semibold leading-[1.05]" style="font-size: clamp(1.6rem, 4vw, 2.6rem);">
                  {b.data.link ? <a href={b.data.link} class="transition-colors hover:text-accent">{b.data.title}</a> : b.data.title}
                </h3>
                <span class:list={["font-sans text-xs uppercase tracking-[0.16em]", b.data.status === "on-deck" ? "text-stellar" : "text-text-muted"]}>{b.data.status === "on-deck" ? "on deck" : "read"}</span>
              </div>
              <p class="mt-1 text-sm uppercase tracking-[0.12em] text-text-muted">{b.data.author}</p>
              <p class="mt-3 text-text-muted">{b.data.note}</p>
            </article>
          ))}
        </div>
      </section>
    ))}
  </main>
</BaseLayout>
