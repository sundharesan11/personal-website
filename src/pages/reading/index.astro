---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sunflower from "../../components/Sunflower.astro";
import { getCollection } from "astro:content";

const books = (await getCollection("reading")).sort((a, b) => a.data.order - b.data.order);
const groups = [...new Set(books.map((b) => b.data.opened))];

// scattered placement: varied indent + width per book (deeper indent pairs with a narrower measure so nothing overflows)
const layout = [
  { ml: "", w: "md:max-w-[52ch]" },
  { ml: "md:ml-[24%]", w: "md:max-w-[42ch]" },
  { ml: "md:ml-[9%]", w: "md:max-w-[50ch]" },
  { ml: "md:ml-[32%]", w: "md:max-w-[40ch]" },
  { ml: "md:ml-[14%]", w: "md:max-w-[48ch]" },
  { ml: "md:ml-[4%]", w: "md:max-w-[52ch]" },
  { ml: "md:ml-[19%]", w: "md:max-w-[44ch]" },
];
---
<BaseLayout title="Reading · Sundharesan Kumaresan">
  <main id="main-content" class="relative mx-auto max-w-[1100px] px-6 pt-16 pb-16">
    <header class="border-t border-border pt-5">
      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <span class="font-sans text-xs uppercase tracking-[0.18em] text-text-muted">The reading room</span>
        <span class="font-sans text-xs uppercase tracking-[0.16em] text-accent">{books.length} books</span>
      </div>
      <h1 class="mt-5 font-serif font-semibold leading-[0.9]" style="font-size: clamp(3rem, 10vw, 7rem);">Reading</h1>
    </header>
    <div class="mt-12 md:grid md:grid-cols-[minmax(0,1fr)_320px] md:gap-12">
      <div>
        {groups.map((g) => (
          <section class="mt-16">
            <h2 class="font-sans text-sm uppercase tracking-[0.18em] text-text-muted">{g}</h2>
            <div class="mt-8 flex flex-col gap-12">
              {books.filter((b) => b.data.opened === g).map((b) => {
                const L = layout[books.findIndex((x) => x.id === b.id) % layout.length];
                return (
                <article class:list={["max-w-[58ch] transition-transform duration-300 hover:-translate-y-1", L.ml, L.w]}>
                  <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                    <h3 class="font-serif font-semibold leading-[1.05]" style="font-size: clamp(1.6rem, 4vw, 2.6rem);">
                      {b.data.link ? <a href={b.data.link} class="transition-colors hover:text-accent">{b.data.title}</a> : b.data.title}
                    </h3>
                    <span class:list={["font-sans text-xs uppercase tracking-[0.16em]", b.data.status === "on-deck" ? "text-accent" : "text-text-muted"]}>{b.data.status === "on-deck" ? "on deck" : "read"}</span>
                  </div>
                  <p class="mt-1 text-sm uppercase tracking-[0.12em] text-text-muted">{b.data.author}</p>
                  <p class="mt-3 text-text-muted">{b.data.note}</p>
                  {b.data.question && (
                    <p class="mt-3 font-serif italic leading-snug text-text" style="font-size: clamp(1.05rem, 2.2vw, 1.4rem);">{b.data.question}</p>
                  )}
                </article>
                );
              })}
            </div>
          </section>
        ))}
      </div>
      <div class="hidden md:block" aria-hidden="true">
        <div class="pointer-events-none sticky top-28 h-[clamp(280px,42vh,440px)] w-full opacity-80">
          <Sunflower />
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
