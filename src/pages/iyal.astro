---
import BaseLayout from "../layouts/BaseLayout.astro";
import EditorialField from "../components/EditorialField.astro";

const themes = [
  "Farmer-investor collaboration",
  "Capital planning and seasonal financing",
  "Market access and price discovery",
  "Farmer-buyer relationships",
  "Logistics coordination",
  "Government support and regulatory navigation",
  "Trust and transparency mechanisms",
  "Community-driven agricultural knowledge",
  "Decision support for farming operations",
  "Long-term behaviour inside agricultural networks",
];

const validation = [
  "Understand a farmer's seasonal planning before pretending software knows the answer.",
  "Coordinate access to capital around real cash-flow moments, not neat spreadsheet fantasies.",
  "Identify buyers, logistics partners, and support systems that can actually show up.",
  "Track operational challenges through the season, especially where trust is gained or quietly lost.",
  "Use simple tools and manual coordination before asking code to carry the weight.",
];

const principles = [
  {
    title: "Farmers first.",
    body: "Technology should support farmers, not replace their judgment.",
  },
  {
    title: "Relationships before transactions.",
    body: "Strong agricultural networks are built on trust, not only contracts.",
  },
  {
    title: "Understand before building.",
    body: "Real workflows should shape software, not the other way around.",
  },
  {
    title: "Transparency creates confidence.",
    body: "Every stakeholder should clearly understand the information relevant to them.",
  },
  {
    title: "Small experiments over large assumptions.",
    body: "One real workflow teaches more than ten hypothetical features.",
  },
  {
    title: "Long-term thinking.",
    body: "Agriculture works across seasons, relationships, and generations. iyal has to think that way too.",
  },
];

const questions = [
  "Can trust between farmers and capital providers become measurable?",
  "What information helps farmers make better decisions?",
  "How can uncertainty throughout a farming season be reduced?",
  "What prevents effective coordination today?",
  "Can software strengthen human relationships instead of replacing them?",
  "What is the smallest intervention that creates meaningful value for a farmer?",
  "How should incentives align between farmers, investors, buyers, logistics providers, and governments?",
];

const web3formsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? "";
---
<BaseLayout
  title="iyal · Sundharesan Kumaresan"
  description="iyal is Sundharesan Kumaresan's active research and product flow exploring agricultural coordination, farmer capital networks, and trust."
>
  <main id="main-content" class="mx-auto max-w-[1100px] px-6 pt-16 pb-16">
    <a href="/to" class="font-sans text-xs uppercase tracking-[0.16em] text-text-muted transition-colors hover:text-text">&larr; To</a>

    <header class="mt-12">
      <p class="font-sans text-xs uppercase tracking-[0.2em] text-text-muted">Farmer capital network · active research</p>
      <h1 class="mt-6 font-script font-normal leading-[0.8] text-accent" style="font-size: clamp(5.4rem, 18vw, 13rem);">iyal</h1>
      <p data-reveal class="mt-8 max-w-[18ch] font-serif font-semibold leading-[1.02]" style="font-size: clamp(1.8rem, 5.5vw, 3.7rem);">Exploring the future of agricultural coordination.</p>
      <p class="mt-8 max-w-[64ch] text-lg leading-relaxed text-text-muted">Agriculture is one of humanity's oldest systems, yet many of the people who depend on it still operate inside disconnected ecosystems. Farmers, investors, buyers, logistics providers, governments, researchers, and startups each solve a small part of the problem. Very few connect them together.</p>
    </header>

    <section class="mt-20 grid gap-10 md:grid-cols-[0.75fr_1.25fr] md:border-t md:border-border md:pt-12">
      <div>
        <p class="font-sans text-xs uppercase tracking-[0.18em] text-accent">What is iyal?</p>
      </div>
      <div class="max-w-[68ch] space-y-6 text-lg leading-relaxed text-text-muted">
        <p><span class="font-script text-3xl leading-none text-accent">iyal</span> is an ongoing research and product flow exploring how technology, human relationships, coordinated workflows, and trust can improve the agricultural ecosystem.</p>
        <p>It does not start with another marketplace. It starts with the ground truth: how decisions are made, where uncertainty appears, what breaks communication, and how different stakeholders move through a farming season.</p>
        <p class="font-serif text-text" style="font-size: clamp(1.35rem, 3vw, 1.9rem);">Better software starts with better understanding. Annoying, inconvenient, and usually correct.</p>
      </div>
    </section>

    <section class="mt-20">
      <p class="font-sans text-xs uppercase tracking-[0.18em] text-accent">Why this matters</p>
      <div class="mt-6 grid gap-12 md:grid-cols-[1fr_0.8fr]">
        <div class="max-w-[68ch] space-y-6 text-lg leading-relaxed text-text-muted">
          <p>Agriculture is not only about growing crops. It is about managing uncertainty.</p>
          <p>Every season asks the same brutal questions in new clothes: when to plant, how to arrange capital, which buyer can be trusted, when to sell, which logistics partner is available, which schemes apply, and how risk should be shared fairly.</p>
          <blockquote class="border-l-2 border-accent pl-6 font-serif italic leading-[1.2] text-text" style="font-size: clamp(1.5rem, 3.8vw, 2.3rem);">Agriculture doesn't only need better technology. It needs better coordination.</blockquote>
        </div>
        <ul class="border-t border-border">
          {themes.map((theme) => (
            <li class="border-b border-border py-4 text-text-muted">{theme}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="mt-24 grid gap-10 md:grid-cols-[0.75fr_1.25fr] md:border-t md:border-border md:pt-12">
      <div>
        <p class="font-sans text-xs uppercase tracking-[0.18em] text-accent">Current validation</p>
      </div>
      <div>
        <p class="max-w-[62ch] text-lg leading-relaxed text-text-muted">I am intentionally not building a large platform yet. The current work is about validating small coordination workflows with real people: farmers, investors, buyers, logistics partners, and the people already trusted on the ground.</p>
        <ol class="mt-8 space-y-6">
          {validation.map((item, index) => (
            <li class="grid gap-4 border-t border-border pt-6 sm:grid-cols-[4rem_1fr]">
              <span class="whitespace-nowrap font-sans text-xs uppercase tracking-[0.18em] text-accent">nº {String(index + 1).padStart(2, "0")}</span>
              <p class="max-w-[58ch] text-text-muted">{item}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="mt-24">
      <div class="flex flex-wrap items-end gap-5">
        <h2 class="font-serif font-semibold leading-[0.95]" style="font-size: clamp(2.2rem, 7vw, 4.8rem);">Principles</h2>
        <span class="mb-4 h-px flex-1 bg-stellar"></span>
      </div>
      <div class="mt-10 grid gap-x-10 gap-y-8 md:grid-cols-2">
        {principles.map((principle) => (
          <article class="border-t border-border pt-6">
            <h3 class="font-serif font-semibold leading-[1.1]" style="font-size: clamp(1.25rem, 3vw, 1.75rem);">{principle.title}</h3>
            <p class="mt-3 max-w-[54ch] text-text-muted">{principle.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-24 grid gap-10 md:grid-cols-[0.75fr_1.25fr] md:border-t md:border-border md:pt-12">
      <div>
        <p class="font-sans text-xs uppercase tracking-[0.18em] text-accent">Questions driving the work</p>
      </div>
      <ul class="max-w-[68ch]">
        {questions.map((question) => (
          <li class="border-b border-border py-4 font-serif leading-[1.28] text-text" style="font-size: clamp(1.05rem, 2.1vw, 1.35rem);">{question}</li>
        ))}
      </ul>
    </section>

    <section class="mt-24">
      <p class="font-sans text-xs uppercase tracking-[0.18em] text-accent">Long-term vision</p>
      <p class="mt-6 max-w-[26ch] font-serif font-semibold leading-[1.05]" style="font-size: clamp(1.6rem, 5vw, 3.1rem);">Infrastructure for people who already do the hard part.</p>
      <p class="mt-8 max-w-[68ch] text-lg leading-relaxed text-text-muted">If today's agricultural systems connect individual participants, iyal is trying to learn what it would take to help them work together more effectively: farmers with better visibility, investors with more confidence, markets that are easier to reach, logistics that are less improvised, and decisions supported by real operational understanding.</p>
      <p class="mt-6 max-w-[68ch] text-lg leading-relaxed text-text-muted">Not overnight. Not by pretending the field is a dashboard. Through learning, experimentation, and collaboration with the people who already know where the system bends.</p>
    </section>

    <section class="mt-28 border-t-2 border-stellar pt-10">
      <div class="grid gap-12 md:grid-cols-[0.85fr_1.15fr]">
        <div>
          <p class="font-sans text-xs uppercase tracking-[0.18em] text-accent">Contribute</p>
          <h2 class="mt-4 max-w-[13ch] font-serif font-semibold leading-[1.02]" style="font-size: clamp(2rem, 5.5vw, 4rem);">Stay close to the work.</h2>
          <p class="mt-8 max-w-[44ch] text-lg leading-relaxed text-text-muted"><span class="font-script text-3xl leading-none text-accent">iyal</span> is still in validation. If agriculture, capital, logistics, policy, or field operations are part of your world, this is the quiet door in.</p>
        </div>
        <form action="https://api.web3forms.com/submit" method="POST" class="border-t border-border pt-6">
          <input type="hidden" name="access_key" value={web3formsAccessKey} />
          <input type="hidden" name="subject" value="iyal field note" />
          <input type="hidden" name="from_name" value="iyal website" />
          <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

          <div class="grid gap-8 sm:grid-cols-2">
            <EditorialField required label="Your name" name="name" autocomplete="name" placeholder="Your full name" />
            <EditorialField required type="email" label="Email" name="email" autocomplete="email" placeholder="Where can I reply?" />
          </div>

          <div class="mt-8">
            <EditorialField
              label="Your role in the ecosystem"
              name="ecosystem_role"
              placeholder="Farmer, investor, buyer, logistics, policy, researcher, operator..."
            />
          </div>

          <div class="mt-8">
            <EditorialField
              label="Where are you working from?"
              name="location_context"
              placeholder="Village, district, state, country, or the market you know best"
            />
          </div>

          <div class="mt-8">
            <EditorialField
              required
              type="textarea"
              label="What are you seeing on the ground?"
              name="message"
              rows={7}
              placeholder="Tell me what breaks, what works, who is trusted, or what I am probably missing."
            />
          </div>

          <div class="mt-8">
            <EditorialField
              required
              type="select"
              label="Can I follow up?"
              name="follow_up_preference"
              placeholder="Choose how open this door should be"
              options={[
                { value: "yes_happy_to_talk", label: "Yes, happy to talk" },
                { value: "email_only", label: "Reply by email only" },
                { value: "not_yet", label: "Not yet, just sharing a note" },
              ]}
            />
          </div>

          <button type="submit" class="mt-10 font-serif font-semibold leading-none text-text transition-colors hover:text-accent" style="font-size: clamp(1.45rem, 3.4vw, 2.25rem);">Send field note <span class="text-accent">&rarr;</span></button>
        </form>
      </div>
    </section>
  </main>
</BaseLayout>
