---
import BaseLayout from "../layouts/BaseLayout.astro";
import EditorialField from "../components/EditorialField.astro";

const themes = [
  "The week before sowing, when cash has to arrive before advice becomes useful",
  "The buyer who says yes on the phone and vanishes when the crop is ready",
  "The truck that is technically available and practically nowhere near the farm",
  "The local operator everyone trusts, even when no software knows their name",
  "The government scheme that exists, but only if someone can navigate the paperwork",
  "The price signal that reaches the farmer late enough to feel like a joke",
  "The repayment plan that respects a season instead of a calendar fantasy",
  "The WhatsApp group where the real market intelligence already lives",
  "The storage decision that turns a good harvest into either breathing room or panic",
  "The quiet question under every deal: who will still show up if this goes badly?",
];

const validation = [
  "Start with one season, one crop, and the exact week money starts deciding the harvest.",
  "Map who the farmer already calls: buyer, transporter, input dealer, lender, neighbour, local fixer.",
  "Find the moment trust breaks: price, pickup, repayment, paperwork, storage, or silence.",
  "Coordinate the smallest useful workflow by hand before asking software to wear a cape.",
  "Keep the farmer's judgment in the loop, because the field is not a dashboard and never has been.",
];

const principles = [
  {
    title: "Farmers first.",
    body: "The person taking the weather, debt, soil, buyer, and family risk gets the first vote.",
  },
  {
    title: "Relationships before transactions.",
    body: "A season runs on people showing up when the spreadsheet has already left the room.",
  },
  {
    title: "Understand before building.",
    body: "The first product is listening carefully enough to stop having clever wrong ideas.",
  },
  {
    title: "Transparency creates confidence.",
    body: "Farmers, buyers, lenders, and operators should know what matters to them without needing a translator.",
  },
  {
    title: "Small experiments over large assumptions.",
    body: "One real crop cycle teaches more than ten hypothetical features.",
  },
  {
    title: "Long-term thinking.",
    body: "Agriculture works across seasons, relationships, and generations. iyal has to think that way too.",
  },
];

const questions = [
  "What does a farmer need to know before borrowing for a season?",
  "Who is already trusted on the ground, and why?",
  "Where does money arrive too late to matter?",
  "Which buyer promises are reliable enough to build around?",
  "What can be coordinated over a phone call before a platform has any right to exist?",
  "Where does logistics quietly eat the farmer's margin?",
  "What is the smallest workflow that makes one season less uncertain?",
];

const web3formsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? "";
const hasWeb3FormsKey = web3formsAccessKey.trim().length > 0;
---
<BaseLayout
  title="iyal · Sundharesan Kumaresan"
  description="iyal is Sundharesan Kumaresan's active research and product flow exploring agricultural coordination, farmer capital networks, and trust."
>
  <main id="main-content" class="mx-auto max-w-[1100px] px-6 pt-16 pb-16">
    <a href="/to" class="font-sans text-xs uppercase tracking-[0.16em] text-text-muted transition-colors hover:text-text">&larr; To</a>

    <header class="mt-12">
      <p class="label-fit font-sans text-xs uppercase tracking-[0.2em] text-text-muted">Farmer capital network · active research</p>
      <h1 class="mt-6 font-script font-normal leading-[0.8] text-accent" style="font-size: clamp(5.4rem, 18vw, 13rem);">iyal</h1>
      <p data-reveal class="display-fit mt-8 max-w-[18ch] font-serif font-semibold leading-[1.02]" style="font-size: clamp(1.6rem, 5.5vw, 3.7rem);">Following the money, trust, and timing of a farming season.</p>
      <p class="text-fit mt-8 max-w-[64ch] text-lg leading-relaxed text-text-muted">A crop does not wait for a clean product brief. Money is needed before sowing, labour before the weather turns, transport before the buyer changes their mind, and trust before anyone signs anything that matters. <span class="font-script text-3xl leading-none text-accent">iyal</span> is my active research thread into that messy middle: how farmers, capital, buyers, logistics, and local operators already move together, and where a small amount of coordination could make the season less brutal.</p>
    </header>

    <section class="mt-20 grid gap-10 md:grid-cols-[0.75fr_1.25fr] md:border-t md:border-border md:pt-12">
      <div>
        <p class="font-sans text-xs uppercase tracking-[0.18em] text-accent">What is iyal?</p>
      </div>
      <div class="max-w-[68ch] space-y-6 text-lg leading-relaxed text-text-muted">
        <p><span class="font-script text-3xl leading-none text-accent">iyal</span> is an ongoing research and product flow about one practical question: what would make a farming season easier to coordinate without insulting the people who already understand it?</p>
        <p>It does not start with another marketplace. It starts with ground truth: who needs money when, which buyer can be trusted, which truck can actually show up, which local person everyone calls, and where silence becomes expensive.</p>
        <p class="font-serif text-text" style="font-size: clamp(1.35rem, 3vw, 1.9rem);">Better software starts with better understanding. Annoying, inconvenient, and usually correct.</p>
      </div>
    </section>

    <section class="mt-20">
      <p class="font-sans text-xs uppercase tracking-[0.18em] text-accent">Why this matters</p>
      <div class="mt-6 grid gap-12 md:grid-cols-[1fr_0.8fr]">
        <div class="max-w-[68ch] space-y-6 text-lg leading-relaxed text-text-muted">
          <p>Agriculture is not only about growing crops. It is about managing uncertainty with real money on the line.</p>
          <p>Every season asks the same brutal questions in new clothes: when to plant, how to arrange capital, which buyer can be trusted, when to sell, which transport is real and which is wishful thinking, which schemes apply, and how risk should be shared fairly.</p>
          <blockquote class="border-l-2 border-accent pl-6 font-serif italic leading-[1.2] text-text" style="font-size: clamp(1.5rem, 3.8vw, 2.3rem);">Agriculture doesn't only need better technology. It needs better coordination.</blockquote>
        </div>
        <ul class="border-t border-border">
          {themes.map((theme) => (
            <li class="border-b border-border py-4 text-text-muted">{theme}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="mt-24 grid gap-10 md:grid-cols-[0.75fr_1.25fr] md:border-t md:border-border md:pt-12">
      <div>
        <p class="font-sans text-xs uppercase tracking-[0.18em] text-accent">Current validation</p>
      </div>
      <div>
        <p class="text-fit max-w-[62ch] text-lg leading-relaxed text-text-muted">I am intentionally not building a large platform yet. The current work is about validating small coordination workflows with real people: farmers, capital providers, buyers, transporters, local operators, and the people already trusted on the ground.</p>
        <ol class="mt-8 space-y-6">
          {validation.map((item, index) => (
            <li class="grid gap-4 border-t border-border pt-6 sm:grid-cols-[4rem_1fr]">
              <span class="whitespace-nowrap font-sans text-xs uppercase tracking-[0.18em] text-accent">nº {String(index + 1).padStart(2, "0")}</span>
              <p class="max-w-[58ch] text-text-muted">{item}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="mt-24">
      <div class="flex flex-wrap items-end gap-5">
        <h2 class="font-serif font-semibold leading-[0.95]" style="font-size: clamp(2.2rem, 7vw, 4.8rem);">Principles</h2>
        <span class="mb-4 h-px flex-1 bg-stellar"></span>
      </div>
      <div class="mt-10 grid gap-x-10 gap-y-8 md:grid-cols-2">
        {principles.map((principle) => (
          <article class="border-t border-border pt-6">
            <h3 class="font-serif font-semibold leading-[1.1]" style="font-size: clamp(1.25rem, 3vw, 1.75rem);">{principle.title}</h3>
            <p class="mt-3 max-w-[54ch] text-text-muted">{principle.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-24 grid gap-10 md:grid-cols-[0.75fr_1.25fr] md:border-t md:border-border md:pt-12">
      <div>
        <p class="font-sans text-xs uppercase tracking-[0.18em] text-accent">Questions driving the work</p>
      </div>
      <ul class="max-w-[68ch]">
        {questions.map((question) => (
          <li class="border-b border-border py-4 font-serif leading-[1.28] text-text" style="font-size: clamp(1.05rem, 2.1vw, 1.35rem);">{question}</li>
        ))}
      </ul>
    </section>

    <section class="mt-24">
      <p class="font-sans text-xs uppercase tracking-[0.18em] text-accent">Long-term vision</p>
      <p class="mt-6 max-w-[26ch] font-serif font-semibold leading-[1.05]" style="font-size: clamp(1.6rem, 5vw, 3.1rem);">Infrastructure for people who already do the hard part.</p>
      <p class="text-fit mt-8 max-w-[68ch] text-lg leading-relaxed text-text-muted">If today's agricultural systems connect individual participants, iyal is trying to learn what it would take to help them work together through the season: farmers with clearer options, capital providers with better context, buyers who can be trusted, transport that is less improvised, and decisions grounded in real operations.</p>
      <p class="text-fit mt-6 max-w-[68ch] text-lg leading-relaxed text-text-muted">Not overnight. Not by pretending the field is a dashboard. Through field notes, small experiments, and collaboration with the people who already know where the system bends.</p>
    </section>

    <section class="mt-28 border-t-2 border-stellar pt-10">
      <div class="grid gap-12 md:grid-cols-[0.85fr_1.15fr]">
        <div>
          <p class="font-sans text-xs uppercase tracking-[0.18em] text-accent">Contribute</p>
          <h2 class="mt-4 max-w-[13ch] font-serif font-semibold leading-[1.02]" style="font-size: clamp(2rem, 5.5vw, 4rem);">Stay close to the work.</h2>
          <p class="mt-8 max-w-[44ch] text-lg leading-relaxed text-text-muted"><span class="font-script text-3xl leading-none text-accent">iyal</span> is still in validation. If agriculture, capital, logistics, policy, or field operations are part of your world, this is the quiet door in.</p>
        </div>
        {hasWeb3FormsKey ? (
          <form action="https://api.web3forms.com/submit" method="POST" class="border-t border-border pt-6">
            <input type="hidden" name="access_key" value={web3formsAccessKey} />
            <input type="hidden" name="subject" value="iyal field note" />
            <input type="hidden" name="from_name" value="iyal website" />
            <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

            <div class="grid gap-8 sm:grid-cols-2">
              <EditorialField required label="Your name" name="name" autocomplete="name" placeholder="Your full name" />
              <EditorialField required type="email" label="Email" name="email" autocomplete="email" placeholder="Where can I reply?" />
            </div>

            <div class="mt-8">
              <EditorialField
                label="Your role in the season"
                name="season_role"
                placeholder="Farmer, lender, buyer, transporter, policy, researcher, operator..."
              />
            </div>

            <div class="mt-8">
              <EditorialField
                label="Where are you working from?"
                name="location_context"
                placeholder="Village, district, state, country, or the market you know best"
              />
            </div>

            <div class="mt-8">
              <EditorialField
                required
                type="textarea"
                label="What are you seeing on the ground?"
                name="message"
                rows={7}
                placeholder="Tell me what breaks, what works, who is trusted, or what I am probably missing."
              />
            </div>

            <div class="mt-8">
              <EditorialField
                required
                type="select"
                label="Can I follow up?"
                name="follow_up_preference"
                placeholder="Choose how open this door should be"
                options={[
                  { value: "yes_happy_to_talk", label: "Yes, happy to talk" },
                  { value: "email_only", label: "Reply by email only" },
                  { value: "not_yet", label: "Not yet, just sharing a note" },
                ]}
              />
            </div>

            <p class="text-fit mt-8 max-w-[52ch] text-sm leading-relaxed text-text-muted">I read these as field notes, not leads in a funnel. If the form misbehaves, send the same note to <a href="mailto:sundharesansk11@gmail.com" class="u-underline text-text hover:text-accent">sundharesansk11@gmail.com</a>.</p>
            <button type="submit" class="mt-8 font-serif font-semibold leading-none text-text transition-colors hover:text-accent" style="font-size: clamp(1.45rem, 3.4vw, 2.25rem);">Send field note <span class="text-accent">&rarr;</span></button>
          </form>
        ) : (
          <section class="border-t border-border pt-6">
            <p class="label-fit font-sans text-xs uppercase tracking-[0.18em] text-accent">Field-note door</p>
            <p class="text-fit mt-5 max-w-[54ch] text-lg leading-relaxed text-text-muted">The form needs a Web3Forms key before it can send properly. Until then, email the note: where you are, what breaks in the season, who is trusted, and what I am probably missing.</p>
            <a href="mailto:sundharesansk11@gmail.com?subject=iyal%20field%20note" class="mt-8 inline-block font-serif font-semibold leading-none text-text transition-colors hover:text-accent" style="font-size: clamp(1.45rem, 3.4vw, 2.25rem);">Email field note <span class="text-accent">&rarr;</span></a>
          </section>
        )}
      </div>
    </section>
  </main>
</BaseLayout>
